{
  "info": {
    "name": "Backend Kos REST API (v1)",
    "description": "Postman Collection lengkap untuk pengujian seluruh 23 endpoint Sistem Informasi Pencarian Kos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Autentikasi",
      "item": [
        {
          "name": "Register Pencari",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Andi Pencari\",\n  \"email\": \"andi.pencari@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"pencari\"\n}"
            },
            "url": { "raw": "{{base_url}}/register" }
          }
        },
        {
          "name": "Register Pemilik",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Budi Juragan\",\n  \"email\": \"budi.juragan@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"pemilik\"\n}"
            },
            "url": { "raw": "{{base_url}}/register" }
          }
        },
        {
          "name": "Login Pemilik",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.environment.set('token_pemilik', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pemilik@kos.test\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login" }
          }
        },
        {
          "name": "Login Pencari",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.environment.set('token_pencari', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pencari@kos.test\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login" }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.environment.set('token_admin', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@kos.test\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login" }
          }
        },
        {
          "name": "Profil Saya (/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/me" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/logout" }
          }
        }
      ]
    },
    {
      "name": "02. Kos & Pencarian",
      "item": [
        {
          "name": "Katalog Kos (Semua)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/kos" }
          }
        },
        {
          "name": "Filter & Cari Kos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/kos?q=Melati&harga_min=500000&harga_max=1500000&jenis=putri&tersedia=1&sort=harga_asc"
            }
          }
        },
        {
          "name": "Detail Kos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/kos/{{kos_id}}" }
          }
        },
        {
          "name": "Tambah Kos (Pemilik)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Kos Gajah Mada Asri\",\n  \"alamat\": \"Jl. Kaliurang KM 5, Sleman, Yogyakarta\",\n  \"deskripsi\": \"Kos eksklusif dekat UGM\",\n  \"jenis\": \"campur\",\n  \"harga\": 1500000,\n  \"fasilitas_ids\": [1, 2, 3]\n}"
            },
            "url": { "raw": "{{base_url}}/kos" }
          }
        },
        {
          "name": "Update Kos (Pemilik)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Kos Gajah Mada Asri (Updated)\",\n  \"harga\": 1600000\n}"
            },
            "url": { "raw": "{{base_url}}/kos/{{kos_id}}" }
          }
        },
        {
          "name": "Hapus Kos (Pemilik / Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/kos/{{kos_id}}" }
          }
        }
      ]
    },
    {
      "name": "03. Manajemen Kamar",
      "item": [
        {
          "name": "Daftar Kamar per Kos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/kos/{{kos_id}}/kamar" }
          }
        },
        {
          "name": "Tambah Kamar (Pemilik)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama_kamar\": \"Kamar VIP-01\",\n  \"harga\": 1200000,\n  \"status\": \"tersedia\"\n}"
            },
            "url": { "raw": "{{base_url}}/kos/{{kos_id}}/kamar" }
          }
        },
        {
          "name": "Update Kamar (Pemilik)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harga\": 1250000,\n  \"status\": \"tersedia\"\n}"
            },
            "url": { "raw": "{{base_url}}/kamar/{{kamar_id}}" }
          }
        },
        {
          "name": "Hapus Kamar (Pemilik)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/kamar/{{kamar_id}}" }
          }
        }
      ]
    },
    {
      "name": "04. Alur Pemesanan (Booking)",
      "item": [
        {
          "name": "Ajukan Booking (Pencari)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    pm.environment.set('pemesanan_id', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pencari}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kamar_id\": {{kamar_id}},\n  \"tanggal_pemesanan\": \"2026-11-01\"\n}"
            },
            "url": { "raw": "{{base_url}}/pemesanan" }
          }
        },
        {
          "name": "Daftar Pemesanan Saya",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pencari}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/pemesanan" }
          }
        },
        {
          "name": "Detail Pemesanan",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pencari}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/pemesanan/{{pemesanan_id}}" }
          }
        },
        {
          "name": "Setujui Booking (Pemilik)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"disetujui\"\n}"
            },
            "url": { "raw": "{{base_url}}/pemesanan/{{pemesanan_id}}/status" }
          }
        },
        {
          "name": "Tolak Booking (Pemilik)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pemilik}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ditolak\"\n}"
            },
            "url": { "raw": "{{base_url}}/pemesanan/{{pemesanan_id}}/status" }
          }
        },
        {
          "name": "Batalkan Booking (Pencari)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_pencari}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dibatalkan\"\n}"
            },
            "url": { "raw": "{{base_url}}/pemesanan/{{pemesanan_id}}/status" }
          }
        }
      ]
    },
    {
      "name": "05. Master Fasilitas & Admin",
      "item": [
        {
          "name": "Daftar Fasilitas (Publik)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/fasilitas" }
          }
        },
        {
          "name": "Tambah Fasilitas (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Water Heater\",\n  \"deskripsi\": \"Pemanas air mandi\"\n}"
            },
            "url": { "raw": "{{base_url}}/fasilitas" }
          }
        },
        {
          "name": "Update Fasilitas (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Water Heater (Gas)\"\n}"
            },
            "url": { "raw": "{{base_url}}/fasilitas/8" }
          }
        },
        {
          "name": "Hapus Fasilitas (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/fasilitas/8" }
          }
        },
        {
          "name": "Daftar Pengguna (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
            },
            "url": { "raw": "{{base_url}}/admin/pengguna?role=pemilik" }
          }
        },
        {
          "name": "Ubah Status Akun Pengguna (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token_admin}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aktif\": false\n}"
            },
            "url": { "raw": "{{base_url}}/admin/pengguna/3/status" }
          }
        }
      ]
    }
  ]
}
