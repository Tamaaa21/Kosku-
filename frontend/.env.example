# URL API Backend Laravel (wajib menyertakan prefix /api/v1)
# Opsi 1: Menjalankan backend via 'php artisan serve' (Standar/Default)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Opsi 2: Menggunakan Virtual Host bawaan Laragon (jika diaktifkan)
# VITE_API_URL=http://backend-kos.test/api/v1

# Opsi 3: Menggunakan DDEV
# VITE_API_URL=https://backend-kos.ddev.site/api/v1
