@startuml KosKu_Activity_Pencarian_Kos
' ========================================================
' PlantUML Activity Diagram: Eksplorasi & Filter Pencarian Kos
' ========================================================

skinparam handwritten false
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif

skinparam activity {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #0F172A
    FontSize 12
}

skinparam activityDiamond {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #0F172A
}

skinparam partition {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    FontColor #0F172A
    FontSize 13
}

|#E0F2FE|Pencari Kos / Pengunjung|
start
:Buka Halaman Utama / Katalog KosKu;
:Tentukan Kriteria Pencarian:
- Kota / Nama Daerah
- Rentang Tarif Sewa
- Tipe Penghuni (Putra / Putri / Campur)
- Fasilitas Unggulan (AC, WiFi, Kamar Mandi Dalam);

:Klik Tombol "Terapkan Filter" / "Cari";

|#F1F5F9|Sistem KosKu|
:Query Basis Data Kos Aktif Sesuai Parameter Filter;

if (Data Kos Ditemukan?) then (ya)
    :Tampilkan Daftar Kartu Properti Kos;
    :Render Pin Marker Lokasi pada Peta Interaktif (Leaflet GPS);
    |#E0F2FE|Pencari Kos / Pengunjung|
    :Eksplorasi Hasil (Scroll List atau Klik Pin Marker Peta);
    :Klik Kartu / Popup Pin Kos yang Diminati;
    |#F1F5F9|Sistem KosKu|
    :Muat Detail Lengkap Kos, Foto Galeri, Unit Kamar, dan Ulasan;
    |#E0F2FE|Pencari Kos / Pengunjung|
    :Melihat Informasi Detail Properti;
else (tidak ada hasil)
    :Tampilkan Notifikasi "Kos Tidak Ditemukan";
    |#E0F2FE|Pencari Kos / Pengunjung|
    :Sesuaikan Kembali Filter Pencarian;
endif

stop
@enduml
