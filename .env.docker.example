APP_NAME=KosKu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# Database Configuration (sesuai container db)
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kosku
DB_USERNAME=kosku
DB_PASSWORD=secret_password_kosku
DB_ROOT_PASSWORD=root_password_kosku

# Jalankan otomatis saat container pertama kali up
RUN_MIGRATIONS=true
RUN_SEEDER=true

# Frontend API URL (relatif terhadap Nginx)
VITE_API_URL=/api/v1

# Logging, Cache & Session
LOG_CHANNEL=stack
LOG_LEVEL=error
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
